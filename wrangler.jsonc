{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaketee",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "limits": {
    "cpu_ms": 30000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jaketee"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      { "name": "SECURITY_LIMITER", "class_name": "SecurityRateLimiter" },
      { "name": "PUBLIC_CACHE_TAGS", "class_name": "PublicCacheTags" }
    ]
  },
  "migrations": [
    { "tag": "security-v1", "new_sqlite_classes": ["SecurityRateLimiter"] },
    { "tag": "public-cache-v1", "new_sqlite_classes": ["PublicCacheTags"] }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
  // Optional cache examples; inactive until explicitly provisioned.
  // ,"r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "jaketee-cache" }]
  // ,"d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "jaketee-tags", "database_id": "<database-id>" }]
  // Optional cache DO bindings/migrations must be appended to the arrays above.
}
