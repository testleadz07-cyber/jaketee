{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaketee",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jaketee"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
  // Optional production cache examples; inactive for free-plan testing.
  // ,"r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "jaketee-cache" }]
  // ,"d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "jaketee-tags", "database_id": "<database-id>" }]
  // ,"durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] }
  // ,"migrations": [{ "tag": "cache-v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}
